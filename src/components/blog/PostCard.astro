---
import { ArrowUpRight, Calendar, Clock } from 'lucide-astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  readingTimeMinutes: number;
  index: number;
}

const { slug, title, description, pubDate, tags, readingTimeMinutes, index } = Astro.props;

const year = pubDate.getUTCFullYear();
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const searchBlob = [title, description, String(year), ...tags]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="post-card group relative rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 p-5 sm:p-6 transition-all hover:border-forest-300 dark:hover:border-forest-700/70"
  data-order={String(index)}
  data-title={title.toLowerCase()}
  data-year={String(year)}
  data-date={String(pubDate.getTime())}
  data-reading-time={String(readingTimeMinutes)}
  data-tags={tags.join('|').toLowerCase()}
  data-search={searchBlob}
>
  <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-forest-700 dark:text-forest-400 mb-1.5">
    <span class="inline-flex items-center gap-1.5">
      <Calendar class="w-3.5 h-3.5" />
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </span>
    <span class="text-neutral-300 dark:text-neutral-700">·</span>
    <span class="inline-flex items-center gap-1.5 text-neutral-500 dark:text-neutral-400">
      <Clock class="w-3.5 h-3.5" />
      {readingTimeMinutes} min read
    </span>
  </div>

  <div class="flex items-start justify-between gap-3 mb-2">
    <h2 class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-neutral-100 leading-snug group-hover:text-forest-700 dark:group-hover:text-forest-400 transition-colors">
      <a href={`/blog/${slug}`} class="after:absolute after:inset-0">
        {title}
      </a>
    </h2>
    <ArrowUpRight class="w-4 h-4 shrink-0 text-neutral-400 group-hover:text-forest-700 dark:group-hover:text-forest-400 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 mt-1" />
  </div>

  <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed mb-4">
    {description}
  </p>

  {tags.length > 0 && (
    <div class="flex flex-wrap items-center gap-1.5">
      {tags.map((tag) => (
        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
          {tag}
        </span>
      ))}
    </div>
  )}
</article>
