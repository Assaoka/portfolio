---
import { BookOpen, Check, ExternalLink, FileText, Quote } from 'lucide-astro';

export interface PaperCardData {
  title: string;
  authors: string;
  super_tag: string;
  venue: string;
  year: number;
  firstAuthor?: boolean;
  tldr: string;
  abstract?: string;
  urls?: Record<string, string>;
  bibtex?: string;
  citations?: number;
  previewImage?: string;
  tags?: string[];
}

interface Props {
  paper: PaperCardData;
  index: number;
}

const { paper, index } = Astro.props;

function formatAuthors(raw: string): string {
  return raw
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-neutral-900 dark:text-neutral-100">$1</strong>');
}

const searchBlob = [
  paper.title,
  paper.authors.replace(/\*\*/g, ''),
  paper.tldr,
  paper.abstract,
  paper.venue,
  String(paper.year),
  ...(paper.tags ?? []),
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="paper-card group rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 p-5 sm:p-6 transition-all hover:border-forest-300 dark:hover:border-forest-700/70"
  data-order={String(index)}
  data-title={paper.title.toLowerCase()}
  data-citations={String(paper.citations ?? 0)}
  data-year={String(paper.year)}
  data-venue={paper.venue}
  data-first-author={paper.firstAuthor ? 'true' : 'false'}
  data-tags={(paper.tags ?? []).join('|').toLowerCase()}
  data-search={searchBlob}
>
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <!-- Top badges -->
      <div class="flex flex-wrap items-center gap-2 mb-2.5">
        {paper.super_tag && (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-forest-50 dark:bg-forest-950/60 text-forest-700 dark:text-forest-300 border border-forest-200/80 dark:border-forest-800/60">
            {paper.super_tag}
          </span>
        )}
        {paper.firstAuthor && (
          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200/80 dark:border-amber-800/50">
            First Author
          </span>
        )}
        {typeof paper.citations === 'number' && paper.citations > 0 && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
            <Quote class="w-3 h-3" />
            {paper.citations} {paper.citations === 1 ? 'citation' : 'citations'}
          </span>
        )}
      </div>

      <!-- Title -->
      <h2 class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-neutral-100 leading-snug mb-1.5">
        {paper.title}
      </h2>

      <!-- Authors -->
      <p
        class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-3"
        set:html={formatAuthors(paper.authors)}
      />

      <!-- TL;DR -->
      <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed mb-4">
        {paper.tldr}
      </p>
    </div>

    <!-- Optional Preview Image / PDF Thumbnail -->
    {paper.previewImage && (
      <div class="shrink-0 sm:w-36 md:w-44">
        <a
          href={paper.urls ? Object.values(paper.urls)[0] : paper.previewImage}
          target="_blank"
          rel="noopener noreferrer"
          class="block overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-800 hover:border-forest-400 dark:hover:border-forest-600 transition-colors"
        >
          <img
            src={paper.previewImage}
            alt={`Preview of ${paper.title}`}
            loading="lazy"
            class="w-full h-28 sm:h-24 object-cover"
          />
        </a>
      </div>
    )}
  </div>

  <!-- Tags -->
  {paper.tags && paper.tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mb-4">
      {paper.tags.map((tag) => (
        <span class="px-2 py-0.5 text-[11px] font-medium rounded bg-neutral-100 dark:bg-neutral-800/80 text-neutral-600 dark:text-neutral-400">
          {tag}
        </span>
      ))}
    </div>
  )}

  <!-- Action Row: Generic URLs + Abstract Toggle + Direct Copy BibTeX -->
  <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-neutral-100 dark:border-neutral-800/80">
    {paper.urls &&
      Object.entries(paper.urls).map(([label, href]) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-forest-600 hover:bg-forest-700 text-white transition-colors"
        >
          <span>{label}</span>
          <ExternalLink class="w-3 h-3" />
        </a>
      ))}

    {paper.abstract && (
      <button
        type="button"
        class="toggle-abstract-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        data-target={`abstract-${index}`}
        aria-expanded="false"
      >
        <FileText class="w-3.5 h-3.5" />
        <span>Abstract</span>
      </button>
    )}

    {paper.bibtex && (
      <button
        type="button"
        class="copy-bibtex-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        data-bibtex={paper.bibtex.trim()}
      >
        <BookOpen class="w-3.5 h-3.5 bibtex-icon" />
        <Check class="w-3.5 h-3.5 check-icon hidden text-forest-600 dark:text-forest-400" />
        <span class="copy-label">Copy BibTeX</span>
      </button>
    )}
  </div>

  <!-- Expandable Abstract -->
  {paper.abstract && (
    <div id={`abstract-${index}`} class="hidden mt-4 pt-4 border-t border-neutral-100 dark:border-neutral-800/80">
      <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-1.5">
        Abstract
      </p>
      <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
        {paper.abstract}
      </p>
    </div>
  )}
</article>
