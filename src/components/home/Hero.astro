---
import { Github, Linkedin, GraduationCap, Mail, FileDown } from 'lucide-astro';
import HuggingFaceIcon from '../icons/HuggingFaceIcon.astro';
import { profileData } from '../../data/profile';

const iconMap = {
  scholar: GraduationCap,
  github: Github,
  linkedin: Linkedin,
  email: Mail,
};
---

<section class="py-6 sm:py-10">
  <!-- Status Badge -->
  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-forest-50 dark:bg-forest-950/70 text-forest-700 dark:text-forest-300 border border-forest-200/70 dark:border-forest-900/60 mb-6">
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-forest-500 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-forest-600 dark:bg-forest-400"></span>
    </span>
    <span> {profileData.statusBadge} </span>
  </div>

  <!-- Main Headline -->
  <div class="space-y-3">
    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100">
      {profileData.name}
    </h1>
    <p class="text-sm sm:text-base font-mono text-zinc-500 dark:text-zinc-400">
      {profileData.fullName}
    </p>
    <p class="text-lg sm:text-xl font-medium text-forest-700 dark:text-forest-400">
      {profileData.title}
    </p>
  </div>

  <!-- Bio Pitch -->
  <p id="hero-bio" class="mt-5 text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-3xl">
    {profileData.bio}
  </p>

  <!-- Key Words & Languages -->
  <div class="mt-6 space-y-1.5 text-xs sm:text-sm">
    <p class="text-zinc-600 dark:text-zinc-400">
      <strong class="font-semibold text-zinc-900 dark:text-zinc-100">Keywords:</strong> {profileData.keywords.join(', ')}
    </p>
    <p class="text-zinc-600 dark:text-zinc-400">
      <strong class="font-semibold text-zinc-900 dark:text-zinc-100">Languages:</strong> {profileData.languages.join(', ')}
    </p>
  </div>

  <!-- Ações e Navegação Interna -->
  <div class="mt-8 space-y-4">
    <!-- Linha 1: Baixar Currículo + Contatos -->
    <div class="flex flex-wrap items-center gap-3">
      <a
        href={profileData.cvUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-forest-700 hover:bg-forest-800 text-white text-sm font-medium transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-forest-600/40"
      >
        <FileDown class="w-4 h-4" />
        <span>Download CV</span>
      </a>

      <!-- Contatos / Redes -->
      <div class="flex items-center gap-1 sm:ml-2">
        {profileData.socialLinks.map((item) => {
          const IconComponent = item.icon === 'huggingface' ? HuggingFaceIcon : iconMap[item.icon];
          return (
            <a
              href={item.href}
              target={item.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={item.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
              aria-label={item.name}
              title={item.name}
              class="p-2 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-forest-700 dark:hover:text-forest-300 hover:bg-forest-50 dark:hover:bg-forest-950/60 transition-colors flex items-center justify-center"
            >
              <IconComponent class="w-4 h-4" />
            </a>
          );
        })}
      </div>
    </div>

    <!-- Linha 2: Links para as partes do currículo -->
    <div class="flex flex-wrap items-center gap-2">
      {profileData.navSections.map((section) => (
        <a
          href={section.href}
          class="inline-flex items-center px-3.5 py-1.5 rounded-lg border border-forest-200 dark:border-forest-900/80 bg-white/60 dark:bg-forest-950/30 hover:bg-forest-50 dark:hover:bg-forest-900/40 text-zinc-800 dark:text-zinc-200 text-xs sm:text-sm font-medium transition-colors"
        >
          {section.label}
        </a>
      ))}
    </div>
  </div>
</section>
