---

<section class="py-8 border-t border-forest-100 dark:border-forest-900/40">
  <div class="mb-6">
    <h2 class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100 uppercase text-xs text-forest-700 dark:text-forest-400">
      Education
    </h2>
  </div>

  <div class="space-y-6">
    {education.map((item) => (
      <div class="space-y-1">
        <!-- Linha 1: Nome - Data -->
        <div class="flex items-baseline justify-between gap-2">
          <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
            {item.degreeEn}
          </h3>
          <span class="text-xs sm:text-sm font-mono text-zinc-500 dark:text-zinc-400 whitespace-nowrap">
            {item.periodEn}
          </span>
        </div>

        <!-- Linha 2: Onde - Nota / Detalhe -->
        <div class="flex items-baseline justify-between gap-2 text-xs sm:text-sm">
          <p class="italic text-zinc-700 dark:text-zinc-300">
            {item.institutionEn}
          </p>
          {item.detailEn && (
            <span class="font-medium text-forest-700 dark:text-forest-400 whitespace-nowrap">
              {item.detailEn}
            </span>
          )}
        </div>

        <!-- Bullet points -->
        <ul class="list-disc list-outside ml-4 pt-1.5 space-y-1 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          {item.bulletsEn.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
