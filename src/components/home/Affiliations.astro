<section class="py-10 border-t border-forest-100 dark:border-forest-900/40">
  <div class="space-y-2 mb-6">
    <h2 class="text-xs uppercase tracking-wider font-semibold text-forest-700 dark:text-forest-400">
      Academic & Lab Experience
    </h2>
    <p class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Affiliations & Trajectory
    </p>
  </div>

  <div class="space-y-4">
    {affiliations.map((item) => (
      <div class="p-5 rounded-xl border border-forest-100 dark:border-forest-900/40 bg-[#ffffff]/60 dark:bg-[#0c140f]/60">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
          <div>
            <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
              {item.institution}
            </h3>
            <p class="text-xs text-forest-700 dark:text-forest-400 font-medium">
              {item.role} · <span class="text-zinc-500 dark:text-zinc-400">{item.location}</span>
            </p>
          </div>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
            {item.period}
          </span>
        </div>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mt-2">
          {item.detail}
