---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/papers', label: 'Papers' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#fafbfa]/85 dark:bg-[#090e0b]/85 border-b border-forest-100 dark:border-forest-900/40 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Name -->
    <a
      href="/"
      class="group flex items-center gap-2 text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 hover:text-forest-700 dark:hover:text-forest-400 transition-colors"
    >
      <span class="w-2.5 h-2.5 rounded-full bg-forest-700 dark:bg-forest-400 group-hover:scale-125 transition-transform duration-200"></span>
      <span>João Assaoka</span>
    </a>

    <!-- Navigation links & Controls -->
    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="flex items-center gap-1 text-sm font-medium">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'px-3 py-1.5 rounded-md transition-colors',
                isActive
                  ? 'text-forest-700 dark:text-forest-300 bg-forest-50 dark:bg-forest-950/70 font-semibold'
                  : 'text-zinc-600 dark:text-zinc-400 hover:text-forest-700 dark:hover:text-forest-300 hover:bg-forest-50/50 dark:hover:bg-forest-950/40'
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="h-4 w-px bg-forest-200 dark:bg-forest-900/60 mx-1"></div>

      <!-- Dark/Light Theme Toggle -->
      <ThemeToggle />
    </div>
  </div>
</header>
