---
import { ExternalLink, Star } from 'lucide-astro';

export interface ProjectCardData {
  title: string;
  description: string;
  role?: string;
  year: number;
  super_tag: string;
  tags?: string[];
  urls?: Record<string, string>;
  previewImage?: string;
  featured?: number;
  stars?: number;
}

interface Props {
  project: ProjectCardData;
  index: number;
}

const { project, index } = Astro.props;
const isFeatured = (project.featured ?? 0) > 0;

const validUrls = project.urls
  ? Object.entries(project.urls).filter(([, href]) => Boolean(href && href.trim()))
  : [];

const allTags = [project.super_tag, ...(project.tags ?? [])].filter(Boolean);

const searchBlob = [
  project.title,
  project.description,
  project.role,
  String(project.year),
  ...allTags,
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="project-card group rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 p-5 sm:p-6 transition-all hover:border-forest-300 dark:hover:border-forest-700/70"
  data-order={String(index)}
  data-title={project.title.toLowerCase()}
  data-year={String(project.year)}
  data-stars={String(project.stars ?? 0)}
  data-score={String(project.featured ?? 0)}
  data-tags={allTags.join('|').toLowerCase()}
  data-featured={isFeatured ? 'true' : 'false'}
  data-search={searchBlob}
>
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <!-- Title + Featured & Stars aligned on the same row -->
      <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
        <h2 class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-neutral-100 leading-snug">
          {project.title}
        </h2>
        <div class="flex flex-wrap items-center gap-1.5 shrink-0">
          {isFeatured && (
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200/80 dark:border-amber-800/50">
              <Star class="w-3 h-3" />
              Featured
            </span>
          )}
          {typeof project.stars === 'number' && project.stars > 0 && (
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
              <Star class="w-3 h-3 text-amber-500" />
              {project.stars} {project.stars === 1 ? 'star' : 'stars'}
            </span>
          )}
        </div>
      </div>

      <!-- Role & Year -->
      <p class="text-xs font-medium text-forest-700 dark:text-forest-400 mb-2.5">
        {[project.role, String(project.year)].filter(Boolean).join(' · ')}
      </p>

      <!-- Description -->
      <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed mb-4">
        {project.description}
      </p>
    </div>

    <!-- Optional Preview Image -->
    {project.previewImage && (
      <div class="shrink-0 sm:w-36 md:w-44">
        <a
          href={validUrls[0]?.[1] || project.previewImage}
          target="_blank"
          rel="noopener noreferrer"
          class="block overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-800 hover:border-forest-400 dark:hover:border-forest-600 transition-colors"
        >
          <img
            src={project.previewImage}
            alt={`Preview of ${project.title}`}
            loading="lazy"
            class="w-full h-28 sm:h-24 object-cover"
          />
        </a>
      </div>
    )}
  </div>

  <!-- Super Tag + Tags aligned together -->
  {allTags.length > 0 && (
    <div class="flex flex-wrap items-center gap-1.5 mb-4">
      {project.super_tag && (
        <span class="px-2 py-0.5 text-[11px] font-semibold rounded bg-forest-50 dark:bg-forest-950/60 text-forest-700 dark:text-forest-300 border border-forest-200/80 dark:border-forest-800/60">
          {project.super_tag}
        </span>
      )}
      {project.tags?.map((tag) => (
        <span class="px-2 py-0.5 text-[11px] font-medium rounded bg-neutral-100 dark:bg-neutral-800/80 text-neutral-600 dark:text-neutral-400">
          {tag}
        </span>
      ))}
    </div>
  )}

  <!-- Action Row: Generic URLs (skipped if empty) -->
  {validUrls.length > 0 && (
    <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-neutral-100 dark:border-neutral-800/80">
      {validUrls.map(([label, href]) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-forest-600 hover:bg-forest-700 text-white transition-colors"
        >
          <span>{label}</span>
          <ExternalLink class="w-3 h-3" />
        </a>
      ))}
    </div>
  )}
</article>
