---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="space-y-4 py-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-forest-50 dark:bg-forest-950/60 text-forest-700 dark:text-forest-300 border border-forest-200/60 dark:border-forest-900/60">
      <span class="w-1.5 h-1.5 rounded-full bg-forest-600 dark:bg-forest-400"></span>
      Portfolio Under Development · Issue #2 Active
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      João Assaoka
    </h1>
    <p class="text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
      Generative AI Engineer & CS PhD Researcher. Designing scalable foundation models and post-training architectures.
    </p>
  </div>
</BaseLayout>
