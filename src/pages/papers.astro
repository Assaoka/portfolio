---
import { getCollection } from 'astro:content';
import { ArrowDownUp, Check, ChevronDown, ExternalLink, Search } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperCard from '../components/papers/PaperCard.astro';
import { fetchScholarMetrics, getPaperCitations, scholarConfig } from '../lib/scholar';

const paperEntries = (await getCollection('papers')).sort((a, b) =>
  a.id.localeCompare(b.id)
);

const rawPapers = paperEntries.map((entry) => entry.data);

const scholarData = await fetchScholarMetrics(
  scholarConfig.userId,
  { citations: scholarConfig.citations, hIndex: scholarConfig.hIndex },
  rawPapers
);

const enrichedPapers = rawPapers.map((paper) => ({
  ...paper,
  citations: getPaperCitations(paper, scholarData),
}));

const years = [...new Set(enrichedPapers.map((p) => p.year))].sort((a, b) => b - a);
const venues = [...new Set(enrichedPapers.map((p) => p.venue))].sort((a, b) =>
  a.localeCompare(b)
);
---

<BaseLayout
  title="Publications | João Assaoka"
  description="Academic publications by João Assaoka in Natural Language Processing, Model Merging, Multimodal Learning, and Financial AI."
>
  <section class="py-8 sm:py-12">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-forest-700 dark:text-forest-400">
          Publications
        </h1>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">
          Peer-reviewed papers in NLP, Model Merging, Multimodal Learning, and Financial AI.
        </p>
      </div>

      {scholarConfig.scholarUrl && (
        <a
          href={scholarConfig.scholarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-forest-700 dark:text-forest-400 hover:underline shrink-0"
        >
          <span>Google Scholar</span>
          <ExternalLink class="w-3.5 h-3.5" />
        </a>
      )}
    </div>

    <!-- Citation & h-index Metrics Bar -->
    <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-8">
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 p-3.5 sm:p-4">
        <p class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
          Publications
        </p>
        <p class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-1">
          {enrichedPapers.length}
        </p>
      </div>
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 p-3.5 sm:p-4">
        <p class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
          Citations
        </p>
        <p class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-1">
          {scholarData.citations}
        </p>
      </div>
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 p-3.5 sm:p-4">
        <p class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
          h-index
        </p>
        <p class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-1">
          {scholarData.hIndex}
        </p>
      </div>
    </div>

    <!-- Search, Compound Filters & Sorting -->
    <div class="space-y-3 mb-6">
      <div class="relative">
        <Search class="w-4 h-4 text-neutral-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
        <input
          id="paper-search"
          type="search"
          placeholder="Search by title, author, venue, or topic..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-sm text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 focus:outline-none focus:border-forest-500 dark:focus:border-forest-500 transition-colors"
        />
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3">
        <!-- Left: Compound Filters -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Year Dropdown -->
          <div class="relative filter-dropdown" data-dropdown="year">
            <button
              type="button"
              class="dropdown-trigger inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-neutral-700 dark:text-neutral-300 hover:border-forest-400 dark:hover:border-forest-600 transition-colors"
              aria-expanded="false"
            >
              <span>Year</span>
              <span class="year-count hidden px-1.5 py-0.2 rounded bg-forest-600 text-white text-[10px]">0</span>
              <ChevronDown class="w-3.5 h-3.5 text-neutral-400" />
            </button>
            <div class="dropdown-menu hidden absolute left-0 mt-1.5 w-40 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-lg p-2 z-20 space-y-1">
              {years.map((year) => (
                <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg text-xs text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-pointer">
                  <input
                    type="checkbox"
                    value={String(year)}
                    class="year-checkbox rounded border-neutral-300 dark:border-neutral-700 text-forest-600 focus:ring-forest-500"
                  />
                  <span>{year}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Venue Dropdown -->
          <div class="relative filter-dropdown" data-dropdown="venue">
            <button
              type="button"
              class="dropdown-trigger inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-neutral-700 dark:text-neutral-300 hover:border-forest-400 dark:hover:border-forest-600 transition-colors"
              aria-expanded="false"
            >
              <span>Conference</span>
              <span class="venue-count hidden px-1.5 py-0.2 rounded bg-forest-600 text-white text-[10px]">0</span>
              <ChevronDown class="w-3.5 h-3.5 text-neutral-400" />
            </button>
            <div class="dropdown-menu hidden absolute left-0 mt-1.5 w-44 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-lg p-2 z-20 space-y-1">
              {venues.map((venue) => (
                <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg text-xs text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-pointer">
                  <input
                    type="checkbox"
                    value={venue}
                    class="venue-checkbox rounded border-neutral-300 dark:border-neutral-700 text-forest-600 focus:ring-forest-500"
                  />
                  <span>{venue}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- First Author Checkbox -->
          <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-neutral-700 dark:text-neutral-300 hover:border-forest-400 dark:hover:border-forest-600 transition-colors cursor-pointer select-none">
            <input
              id="first-author-checkbox"
              type="checkbox"
              class="rounded border-neutral-300 dark:border-neutral-700 text-forest-600 focus:ring-forest-500"
            />
            <span>First Author</span>
          </label>
        </div>

        <!-- Right: Sorting -->
        <div class="flex items-center gap-1.5">
          <select
            id="paper-sort"
            aria-label="Sort publications by"
            class="px-3 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-neutral-700 dark:text-neutral-300 focus:outline-none focus:border-forest-500 transition-colors"
          >
            <option value="order">Publication Order</option>
            <option value="title">Title (A–Z)</option>
            <option value="citations">Citations</option>
          </select>

          <button
            id="sort-direction-btn"
            type="button"
            title="Toggle sort direction"
            data-dir="asc"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-neutral-700 dark:text-neutral-300 hover:border-forest-400 dark:hover:border-forest-600 transition-colors"
          >
            <ArrowDownUp class="w-3.5 h-3.5" />
            <span id="sort-dir-label">Asc</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Papers List -->
    <div id="papers-list" class="space-y-4">
      {enrichedPapers.map((paper, index) => (
        <PaperCard paper={paper} index={index} />
      ))}
    </div>

    <p
      id="papers-empty"
      class="hidden text-center py-12 text-sm text-neutral-500 dark:text-neutral-400"
    >
      No publications match your current filter.
    </p>
  </section>

  <!-- Toast notification for BibTeX copy -->
  <div
    id="bibtex-toast"
    role="status"
    aria-live="polite"
    class="fixed top-20 right-6 z-50 hidden items-center gap-2 px-4 py-2.5 rounded-xl bg-forest-600 text-white border border-forest-500 text-xs sm:text-sm font-medium shadow-lg"
  >
    <Check class="w-4 h-4 text-white" />
    <span>BibTeX copied to clipboard!</span>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('paper-search') as HTMLInputElement | null;
  const yearCheckboxes = document.querySelectorAll<HTMLInputElement>('.year-checkbox');
  const venueCheckboxes = document.querySelectorAll<HTMLInputElement>('.venue-checkbox');
  const firstAuthorCheckbox = document.getElementById('first-author-checkbox') as HTMLInputElement | null;
  const sortSelect = document.getElementById('paper-sort') as HTMLSelectElement | null;
  const sortDirBtn = document.getElementById('sort-direction-btn') as HTMLButtonElement | null;
  const sortDirLabel = document.getElementById('sort-dir-label');
  const papersList = document.getElementById('papers-list');
  const emptyState = document.getElementById('papers-empty');

  const yearCountBadge = document.querySelector('.year-count');
  const venueCountBadge = document.querySelector('.venue-count');

  // Dropdown open/close handling
  document.querySelectorAll<HTMLElement>('.filter-dropdown').forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>('.dropdown-trigger');
    const menu = dropdown.querySelector<HTMLElement>('.dropdown-menu');

    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = menu?.classList.contains('hidden');
      document.querySelectorAll('.dropdown-menu').forEach((m) => m.classList.add('hidden'));
      document.querySelectorAll('.dropdown-trigger').forEach((t) => t.setAttribute('aria-expanded', 'false'));
      if (isHidden) {
        menu?.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.filter-dropdown')) {
      document.querySelectorAll('.dropdown-menu').forEach((m) => m.classList.add('hidden'));
      document.querySelectorAll('.dropdown-trigger').forEach((t) => t.setAttribute('aria-expanded', 'false'));
    }
  });

  function updateCountBadge(badge: Element | null, count: number) {
    if (!badge) return;
    badge.textContent = String(count);
    badge.classList.toggle('hidden', count === 0);
  }

  function applyFiltersAndSort() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    const selectedYears = [...yearCheckboxes].filter((c) => c.checked).map((c) => c.value);
    const selectedVenues = [...venueCheckboxes].filter((c) => c.checked).map((c) => c.value);
    const onlyFirstAuthor = firstAuthorCheckbox?.checked ?? false;

    updateCountBadge(yearCountBadge, selectedYears.length);
    updateCountBadge(venueCountBadge, selectedVenues.length);

    const cards = [...document.querySelectorAll<HTMLElement>('.paper-card')];
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesSearch = !query || (card.dataset.search || '').includes(query);
      const matchesYear =
        selectedYears.length === 0 || selectedYears.includes(card.dataset.year || '');
      const matchesVenue =
        selectedVenues.length === 0 || selectedVenues.includes(card.dataset.venue || '');
      const matchesFirstAuthor = !onlyFirstAuthor || card.dataset.firstAuthor === 'true';

      const visible = matchesSearch && matchesYear && matchesVenue && matchesFirstAuthor;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    });

    // Sort cards
    const sortBy = sortSelect?.value || 'order';
    const dir = sortDirBtn?.dataset.dir === 'desc' ? -1 : 1;

    cards.sort((a, b) => {
      if (sortBy === 'title') {
        return (a.dataset.title || '').localeCompare(b.dataset.title || '') * dir;
      }
      if (sortBy === 'citations') {
        return (Number(a.dataset.citations || 0) - Number(b.dataset.citations || 0)) * dir;
      }
      return (Number(a.dataset.order || 0) - Number(b.dataset.order || 0)) * dir;
    });

    if (papersList) {
      cards.forEach((card) => papersList.appendChild(card));
    }

    emptyState?.classList.toggle('hidden', visibleCount > 0);
  }

  yearCheckboxes.forEach((cb) => cb.addEventListener('change', applyFiltersAndSort));
  venueCheckboxes.forEach((cb) => cb.addEventListener('change', applyFiltersAndSort));
  firstAuthorCheckbox?.addEventListener('change', applyFiltersAndSort);
  searchInput?.addEventListener('input', applyFiltersAndSort);
  sortSelect?.addEventListener('change', applyFiltersAndSort);

  sortDirBtn?.addEventListener('click', () => {
    const nextDir = sortDirBtn.dataset.dir === 'asc' ? 'desc' : 'asc';
    sortDirBtn.dataset.dir = nextDir;
    if (sortDirLabel) sortDirLabel.textContent = nextDir === 'asc' ? 'Asc' : 'Desc';
    applyFiltersAndSort();
  });

  // Abstract & BibTeX toggles
  document.querySelectorAll<HTMLButtonElement>('.toggle-abstract-btn, .toggle-bibtex-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target;
      if (!targetId) return;
      const target = document.getElementById(targetId);
      if (!target) return;
      const isHidden = target.classList.contains('hidden');
      target.classList.toggle('hidden', !isHidden);
      btn.setAttribute('aria-expanded', String(isHidden));
    });
  });

  // Copy BibTeX directly to clipboard + toast notification
  const bibtexToast = document.getElementById('bibtex-toast');
  let toastTimer: number | undefined;

  function showBibtexToast() {
    if (!bibtexToast) return;
    bibtexToast.classList.remove('hidden');
    bibtexToast.classList.add('flex');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      bibtexToast.classList.add('hidden');
      bibtexToast.classList.remove('flex');
    }, 2500);
  }

  document.querySelectorAll<HTMLButtonElement>('.copy-bibtex-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const bibtex = btn.dataset.bibtex;
      if (!bibtex) return;
      try {
        await navigator.clipboard.writeText(bibtex);
        const bibtexIcon = btn.querySelector('.bibtex-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const label = btn.querySelector('.copy-label');
        bibtexIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        if (label) label.textContent = 'Copied!';
        showBibtexToast();
        setTimeout(() => {
          bibtexIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          if (label) label.textContent = 'Copy BibTeX';
        }, 2000);
      } catch {
        // Fallback ignored
      }
    });
  });
</script>
