---
import { getCollection } from 'astro:content';
import { ArrowDownUp, ChevronDown, ExternalLink, Github, Search } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { fetchGitHubMetrics, getProjectStars, githubConfig } from '../lib/github';

const projectEntries = (await getCollection('projects')).sort((a, b) =>
  a.id.localeCompare(b.id)
);

const ghMetrics = await fetchGitHubMetrics(githubConfig.username, {
  publicRepos: githubConfig.fallbackRepos,
  totalStars: githubConfig.fallbackStars,
  repoStars: {},
});

const projects = projectEntries
  .map((entry) => ({
    ...entry.data,
    stars: getProjectStars(entry.data.urls, ghMetrics.repoStars),
  }))
  .sort((a, b) => (b.featured ?? 0) - (a.featured ?? 0));

const years = [...new Set(projects.map((p) => p.year))].sort((a, b) => b - a);
const allTags = [
  ...new Set(projects.flatMap((p) => [p.super_tag, ...(p.tags ?? [])]).filter(Boolean)),
].sort((a, b) => a.localeCompare(b));
---

<BaseLayout
  title="Projects | João Assaoka"
  description="Software, Generative AI, and research engineering projects by João Assaoka."
>
  <section class="py-8 sm:py-12">
    <div class="flex items-center justify-between gap-4 mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-forest-700 dark:text-forest-400">
        Projects
      </h1>

      <a
        href={githubConfig.profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-forest-700 dark:text-forest-400 hover:underline shrink-0"
      >
        <Github class="w-4 h-4" />
        <span>GitHub</span>
        <ExternalLink class="w-3.5 h-3.5" />
      </a>
    </div>

    <!-- GitHub & Projects Metrics Bar -->
    <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-8">
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 p-3.5 sm:p-4">
        <p class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
          Projects
        </p>
        <p class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-1">
          {projects.length}
        </p>
      </div>
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 p-3.5 sm:p-4">
        <p class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
          Public Repos
        </p>
        <p class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-1">
          {ghMetrics.publicRepos}
        </p>
      </div>
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 p-3.5 sm:p-4">
        <p class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
          GitHub Stars
        </p>
        <p class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-1">
          {ghMetrics.totalStars}
        </p>
      </div>
    </div>

    <!-- Search, Compound Filters & Sorting -->
    <div class="space-y-3 mb-6">
      <div class="relative">
        <Search class="w-4 h-4 text-neutral-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
        <input
          id="project-search"
          type="search"
          placeholder="Search by title, description, or tech stack..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-sm text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 focus:outline-none focus:border-forest-500 dark:focus:border-forest-500 transition-colors"
        />
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3">
        <!-- Left: Compound Filters -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Year Dropdown -->
          <div class="relative filter-dropdown" data-dropdown="year">
            <button
              type="button"
              class="dropdown-trigger inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-neutral-700 dark:text-neutral-300 hover:border-forest-400 dark:hover:border-forest-600 transition-colors"
              aria-expanded="false"
            >
              <span>Year</span>
              <span class="year-count hidden px-1.5 py-0.2 rounded bg-forest-600 text-white text-[10px]">0</span>
              <ChevronDown class="w-3.5 h-3.5 text-neutral-400" />
            </button>
            <div class="dropdown-menu hidden absolute left-0 mt-1.5 w-40 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-lg p-2 z-20 space-y-1">
              {years.map((year) => (
                <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg text-xs text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-pointer">
                  <input
                    type="checkbox"
                    value={String(year)}
                    class="year-checkbox rounded border-neutral-300 dark:border-neutral-700 text-forest-600 focus:ring-forest-500"
                  />
                  <span>{year}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Tags Dropdown (matches super_tag or tags) -->
          <div class="relative filter-dropdown" data-dropdown="tags">
            <button
              type="button"
              class="dropdown-trigger inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-neutral-700 dark:text-neutral-300 hover:border-forest-400 dark:hover:border-forest-600 transition-colors"
              aria-expanded="false"
            >
              <span>Tags</span>
              <span class="tag-count hidden px-1.5 py-0.2 rounded bg-forest-600 text-white text-[10px]">0</span>
              <ChevronDown class="w-3.5 h-3.5 text-neutral-400" />
            </button>
            <div class="dropdown-menu hidden absolute left-0 mt-1.5 w-52 max-h-64 overflow-y-auto rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-lg p-2 z-20 space-y-1">
              {allTags.map((tag) => (
                <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg text-xs text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-pointer">
                  <input
                    type="checkbox"
                    value={tag.toLowerCase()}
                    class="tag-checkbox rounded border-neutral-300 dark:border-neutral-700 text-forest-600 focus:ring-forest-500"
                  />
                  <span>{tag}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Featured Checkbox -->
          <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-neutral-700 dark:text-neutral-300 hover:border-forest-400 dark:hover:border-forest-600 transition-colors cursor-pointer select-none">
            <input
              id="featured-checkbox"
              type="checkbox"
              class="rounded border-neutral-300 dark:border-neutral-700 text-forest-600 focus:ring-forest-500"
            />
            <span>Featured</span>
          </label>
        </div>

        <!-- Right: Sorting -->
        <div class="flex items-center gap-1.5">
          <select
            id="project-sort"
            aria-label="Sort projects by"
            class="px-3 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-neutral-700 dark:text-neutral-300 focus:outline-none focus:border-forest-500 transition-colors"
          >
            <option value="score">Score</option>
            <option value="title">Title (A–Z)</option>
            <option value="year">Year</option>
            <option value="stars">Stars</option>
          </select>

          <button
            id="sort-direction-btn"
            type="button"
            title="Toggle sort direction"
            data-dir="desc"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-medium border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 text-neutral-700 dark:text-neutral-300 hover:border-forest-400 dark:hover:border-forest-600 transition-colors"
          >
            <ArrowDownUp class="w-3.5 h-3.5" />
            <span id="sort-dir-label">Desc</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Projects List -->
    <div id="projects-list" class="space-y-4">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>

    <p
      id="projects-empty"
      class="hidden text-center py-12 text-sm text-neutral-500 dark:text-neutral-400"
    >
      No projects match your current filter.
    </p>
  </section>
</BaseLayout>

<script>
  const searchInput = document.getElementById('project-search') as HTMLInputElement | null;
  const yearCheckboxes = document.querySelectorAll<HTMLInputElement>('.year-checkbox');
  const tagCheckboxes = document.querySelectorAll<HTMLInputElement>('.tag-checkbox');
  const featuredCheckbox = document.getElementById('featured-checkbox') as HTMLInputElement | null;
  const sortSelect = document.getElementById('project-sort') as HTMLSelectElement | null;
  const sortDirBtn = document.getElementById('sort-direction-btn') as HTMLButtonElement | null;
  const sortDirLabel = document.getElementById('sort-dir-label');
  const projectsList = document.getElementById('projects-list');
  const emptyState = document.getElementById('projects-empty');

  const yearCountBadge = document.querySelector('.year-count');
  const tagCountBadge = document.querySelector('.tag-count');

  // Dropdown open/close handling
  document.querySelectorAll<HTMLElement>('.filter-dropdown').forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>('.dropdown-trigger');
    const menu = dropdown.querySelector<HTMLElement>('.dropdown-menu');

    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = menu?.classList.contains('hidden');
      document.querySelectorAll('.dropdown-menu').forEach((m) => m.classList.add('hidden'));
      document.querySelectorAll('.dropdown-trigger').forEach((t) => t.setAttribute('aria-expanded', 'false'));
      if (isHidden) {
        menu?.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.filter-dropdown')) {
      document.querySelectorAll('.dropdown-menu').forEach((m) => m.classList.add('hidden'));
      document.querySelectorAll('.dropdown-trigger').forEach((t) => t.setAttribute('aria-expanded', 'false'));
    }
  });

  function updateCountBadge(badge: Element | null, count: number) {
    if (!badge) return;
    badge.textContent = String(count);
    badge.classList.toggle('hidden', count === 0);
  }

  function applyFiltersAndSort() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    const selectedYears = [...yearCheckboxes].filter((c) => c.checked).map((c) => c.value);
    const selectedTags = [...tagCheckboxes].filter((c) => c.checked).map((c) => c.value);
    const onlyFeatured = featuredCheckbox?.checked ?? false;

    updateCountBadge(yearCountBadge, selectedYears.length);
    updateCountBadge(tagCountBadge, selectedTags.length);

    const cards = [...document.querySelectorAll<HTMLElement>('.project-card')];
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardTags = (card.dataset.tags || '').split('|').filter(Boolean);
      const matchesSearch = !query || (card.dataset.search || '').includes(query);
      const matchesYear =
        selectedYears.length === 0 || selectedYears.includes(card.dataset.year || '');
      const matchesTags =
        selectedTags.length === 0 || selectedTags.some((t) => cardTags.includes(t));
      const matchesFeatured = !onlyFeatured || card.dataset.featured === 'true';

      const visible = matchesSearch && matchesYear && matchesTags && matchesFeatured;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    });

    const sortBy = sortSelect?.value || 'score';
    const dir = sortDirBtn?.dataset.dir === 'desc' ? -1 : 1;

    cards.sort((a, b) => {
      if (sortBy === 'title') {
        return (a.dataset.title || '').localeCompare(b.dataset.title || '') * dir;
      }
      if (sortBy === 'year') {
        return (Number(a.dataset.year || 0) - Number(b.dataset.year || 0)) * dir;
      }
      if (sortBy === 'stars') {
        return (Number(a.dataset.stars || 0) - Number(b.dataset.stars || 0)) * dir;
      }
      return (Number(a.dataset.score || 0) - Number(b.dataset.score || 0)) * dir;
    });

    if (projectsList) {
      cards.forEach((card) => projectsList.appendChild(card));
    }

    emptyState?.classList.toggle('hidden', visibleCount > 0);
  }

  yearCheckboxes.forEach((cb) => cb.addEventListener('change', applyFiltersAndSort));
  tagCheckboxes.forEach((cb) => cb.addEventListener('change', applyFiltersAndSort));
  featuredCheckbox?.addEventListener('change', applyFiltersAndSort);
  searchInput?.addEventListener('input', applyFiltersAndSort);
  sortSelect?.addEventListener('change', applyFiltersAndSort);

  sortDirBtn?.addEventListener('click', () => {
    const nextDir = sortDirBtn.dataset.dir === 'asc' ? 'desc' : 'asc';
    sortDirBtn.dataset.dir = nextDir;
    if (sortDirLabel) sortDirLabel.textContent = nextDir === 'asc' ? 'Asc' : 'Desc';
    applyFiltersAndSort();
  });
</script>
